{
  "name": "self-telegram-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "deploy:telegram": "wrangler deploy --config wrangler.jsonc",
    "dev:telegram": "wrangler dev --config wrangler.jsonc",
    "deploy:bale": "wrangler deploy --config wrangler.bale.jsonc",
    "dev:bale": "wrangler dev --config wrangler.bale.jsonc",
    "data:show": "node scripts/manage_data.js show",
    "data:encrypt": "node scripts/manage_data.js encrypt",
    "data:decrypt": "node scripts/manage_data.js decrypt",
    "data:set": "node scripts/manage_data.js set",
    "url:encrypt": "node scripts/manage_data.js encrypt_url",
    "url:decrypt": "node scripts/manage_data.js decrypt_url",
    "encrypt": "node scripts/manage_data.js encrypt_val",
    "decrypt": "node scripts/manage_data.js decrypt_val",
    "encrypt:file": "node scripts/manage_data.js encrypt_file",
    "decrypt:file": "node scripts/manage_data.js decrypt_file",
    "pull": "rm -f .git/index.lock 2>/dev/null; git checkout origin/main -- data/data.json 2>/dev/null; git pull --rebase -X theirs origin main",
    "sync": "rm -f .git/index.lock 2>/dev/null; git pull --rebase origin main",
    "push": "rm -f .git/index.lock 2>/dev/null; git pull --rebase origin main && git push origin main",
    "ship": "rm -f .git/index.lock 2>/dev/null; git pull --rebase origin main && git push origin main && npm run deploy:bale && npm run deploy:telegram",
    "start": "wrangler dev",
    "test": "node --test test/scraper.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "vitest": "~5.0.3",
    "wrangler": "^4.166.0"
  }
}