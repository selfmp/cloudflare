{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "self-telegram-bot",
	"main": "src/index.js",
	"compatibility_date": "2024-01-01",
	// متغیرهای عمومی ورکر
	"vars": {
		"GITHUB_OWNER": "selfmp",
		"GITHUB_REPO": "cloudflare",
		"GITHUB_WORKFLOW": "scrape.yml",
		"GITHUB_BRANCH": "main",
		"START_REPLY_TEXT": "سلام! ربات فعال است. هر زمان پیام جدیدی در کانال‌ها منتشر شود برای شما ارسال خواهد شد."
	},
	"kv_namespaces": [
		{
			"binding": "LAST_IDS",
			"id": "291ee0e053874304baabe222553ea893"
		}
	],
	// تریگر کرون در ورکر تلگرام غیرفعال شده است؛ تریگر زمان‌بندی‌شده دوره‌ای روی ورکر بله اجرا می‌شود
	// "triggers": {
	//   "crons": ["*/30 * * * *"]
	// }
}