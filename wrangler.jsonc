{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "self-telegram-bot",
  "main": "src/index.js",
  "compatibility_date": "2024-01-01",

  // متغیرهای عمومی ورکر
  "vars": {
    "GITHUB_OWNER": "selfmp",
    "GITHUB_REPO": "cloudflare",
    "GITHUB_WORKFLOW": "scrape.yml",
    "GITHUB_BRANCH": "main",
    "START_REPLY_TEXT": "سلام! ربات فعال است. هر زمان پیام جدیدی در کانال‌ها منتشر شود برای شما ارسال خواهد شد."
  },

  "triggers": {
    // برای تست روی ۱ دقیقه تنظیم شده است (برای ۳۰ دقیقه: "*/30 * * * *")
    "crons": ["* * * * *"]
  }
}
